{
  "name": "pi-claude-sandbox",
  "version": "0.7.0",
  "description": "Claude-style OS-level sandboxing for pi with interactive permission prompts. Coexists with pi-tool-display and other bash-overriding extensions. Forked from carderne/pi-sandbox, then forked by javapacr for profile-aware config handling and documentation fixes.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "sandbox",
    "claude"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javapacr/pi-claude-sandbox.git"
  },
  "author": "Son Dinh",
  "contributors": [
    "Chris Arderne <chris@rdrn.me> (original pi-sandbox)",
    "Mario Zechner (original pi-mono sandbox example)",
    "javapacr (profile-aware config fixes)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/javapacr/pi-claude-sandbox/issues"
  },
  "homepage": "https://github.com/javapacr/pi-claude-sandbox",
  "scripts": {
    "fmt": "oxfmt index.ts",
    "lint": "oxlint index.ts",
    "check": "tsc --noEmit",
    "ci:fmt": "oxfmt --check index.ts",
    "ci:lint": "npm run lint",
    "ci:check": "npm run check"
  },
  "dependencies": {
    "@carderne/sandbox-runtime": "^0.0.43"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  }
}